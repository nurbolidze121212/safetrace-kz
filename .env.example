# Server only. Never put this key in VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Exact, explicitly authorized public hosts, separated by commas. Empty disables live fetch.
SAFETRACE_ALLOWED_HOSTS=
SAFETRACE_OFFLINE=0
# Defaults to ./data, not served as a directory.
SAFETRACE_DATA_DIR=
